<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="kuka_iiwa7">

  <xacro:arg name="sim_gazebo" default="false" />
  <xacro:arg name="sim_ignition" default="true" />
  <xacro:arg name="simulation_controllers" default="" />
  <xacro:property
    name="initial_positions"
    value="${xacro.load_yaml('$(find lbks_description)/config/kuka_initial_positions.yaml')}" />

  <link
    name="base_link">
    <inertial>
      <origin
        xyz="-0.012856764088336 7.05371084939836E-07 0.0679655592591469"
        rpy="0 0 0" />
      <mass
        value="30.2763517543289" />
      <inertia
        ixx="0.111239565538359"
        ixy="-3.81097437253422E-07"
        ixz="0.00486659750522703"
        iyy="0.139017104291389"
        iyz="7.87871531503135E-07"
        izz="0.133028621926226" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="file://$(find lbks_description)/meshes/kuka_iiwa7/visual/base_link.dae" />
      </geometry>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
        filename="file://$(find lbks_description)/meshes/kuka_iiwa7/collision/base_link.stl" />
      </geometry>
    </collision>
  </link>
  <link
