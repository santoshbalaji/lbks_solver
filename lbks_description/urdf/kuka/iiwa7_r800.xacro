      rpy="1.5708 0 0" />
    <parent
      link="link_6" />
    <child
      link="link_7" />
    <axis
      xyz="0 0 1" />
    <limit
      lower="-3.05"
      upper="3.05"
      effort="40"
      velocity="3.14" />
