      <mass
        value="25.140328983289" />
      <inertia
        ixx="0.197630839812683"
        ixy="-3.9082887807781E-07"
        ixz="-3.24564289064112E-07"
        iyy="0.0602723071447973"
        iyz="0.0367195588674331"
        izz="0.187556898167347" />
    </inertial>
    <visual>
