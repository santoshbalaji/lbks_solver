  </link>
  <joint
    name="joint_5"
    type="revolute">
    <origin
      xyz="0 -0.3993 0"
      rpy="1.5708 0 0" />
    <parent
      link="link_4" />
    <child
      link="link_5" />
    <axis
      xyz="0 0 -1" />
    <limit
      lower="-2.97"
      upper="2.97"
      effort="110"
      velocity="2.44" />
