Panels:
  - Class: lbks_gui/ControlPanel
    Name: IK Studio
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
  - Class: lbks_gui/NetworkPanel
    Name: Network inspector
    Dock at bottom: true
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 24; 29; 39
    Fixed Frame: world
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Ground
      Enabled: true
      Cell Size: 0.1
      Plane Cell Count: 30
      Color: 65; 76; 92
      Alpha: 0.5
    - Class: rviz_default_plugins/RobotModel
      Name: Robot arm
      Enabled: true
      Alpha: 1
      Visual Enabled: true
      Collision Enabled: false
      Description Source: Topic
      Description Topic:
        Value: /lbks_gui/robot_description
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/RobotModel
      Name: Collision geometry
      Enabled: false
      Alpha: 0.35
      Visual Enabled: false
      Collision Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /lbks_gui/robot_description
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/MarkerArray
      Name: Target and position error
      Enabled: true
      Topic:
        Value: /lbks_gui/markers
        Depth: 10
        Reliability Policy: Reliable
        Durability Policy: Volatile
    - Class: rviz_default_plugins/InteractiveMarkers
      Name: Drag Cartesian target
      Enabled: true
      Interactive Markers Namespace: /lbks_gui/target
      Show Descriptions: true
      Show Axes: false
    - Class: rviz_default_plugins/MarkerArray
      Name: Collision results
      Enabled: true
      Topic:
        Value: /lbks_gui/collision_markers
        Depth: 10
        Reliability Policy: Reliable
        Durability Policy: Volatile
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/PublishPoint
      Topic: /clicked_point
      Single click: false
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2.4
      Focal Point: {X: 0.2, Y: 0.0, Z: 0.4}
      Pitch: 0.4
      Yaw: 0.8
      Target Frame: <Fixed Frame>
Window Geometry:
  Width: 1440
  Height: 920
  X: 40
  Y: 40
